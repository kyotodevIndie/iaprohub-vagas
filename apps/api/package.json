{
  "name": "@iaprohub-vagas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/migrate-cli.ts",
    "client:create": "tsx --env-file=.env src/client-cli.ts",
    "test": "LOG_LEVEL=silent vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
