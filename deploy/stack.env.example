# <servidor>:/home/deploy/iaprohub-vagas/stack.env (chmod 600). O vps-deploy.sh cria este arquivo com segredos novos se ele não existir.
TAG=
DOMAIN=iaprohub.vagas.aurora-saas.com.br
POSTGRES_PASSWORD=
ADMIN_TOKEN=
# Google AdSense (opcional): id do publicador e o slot do bloco "no feed". Vazio = sem AdSense.
ADSENSE_CLIENT=
ADSENSE_SLOT=
# E-mail (Resend): sem isso, o login por código não funciona em produção.
RESEND_API_KEY=
EMAIL_FROM=IAPro Vagas <vagas@aurora-saas.com.br>
# Cobrança do Pro (Nox). Webhook no Nox: https://<DOMAIN>/api/v1/nox/webhook
NOX_URL=
NOX_CLIENT_ID=
NOX_SECRET=
NOX_PRODUCT=iaprohub-vagas
NOX_PLAN=pro
# WhatsApp (Evolution API em ~/dev/evolution, na mesma rede "proxy"). O grupo é escolhido em /admin/resumo.
EVOLUTION_URL=http://evolution-api-1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=iapro
DIGEST_HOUR=9
